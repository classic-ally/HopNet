<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Upgrade-required notification (RFC-023); denial is non-fatal, the
         in-app banner remains the guaranteed signal. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- QR pairing is optional; the manual-entry form covers camera-less devices -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- allowBackup off: the pairing token is a bearer credential and must
         not ride device backups; re-pairing is cheap. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HopDrive">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HopDrive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- DocumentsProvider for Storage Access Framework integration -->
        <provider
            android:name=".HopDriveProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>
