# macOS build/release configuration — copy to .env and fill in.
# .env is gitignored; .env.example is the template.
#
# Local builds (stages 00-04 only): only SIGNING_IDENTITY is needed, and even
# that auto-detects from the login keychain when unset.
#
# Release builds (adds stages 05-06): all four values required for notary.

# Codesign identity SHA-1 fingerprint. When unset, scripts run:
#   security find-identity -v -p codesigning login.keychain | grep "Developer ID Application"
# and use the first match. Set explicitly to pin a specific cert.
# SIGNING_IDENTITY=

# Apple ID email (notary submission)
# APPLE_ID=you@example.com

# 10-character Apple Team ID (from developer.apple.com → Membership)
# TEAM_ID=BG4AR9DHD6

# App-specific password generated at appleid.apple.com → Sign-In and Security
# → App-Specific Passwords. NOT your Apple ID password.
# NOTARY_PASSWORD=xxxx-xxxx-xxxx-xxxx
